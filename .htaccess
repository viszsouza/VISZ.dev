# Página inicial só existe em https://agenciavisz.com/ (evita duas URLs para a mesma página)
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Página 404 personalizada
ErrorDocument 404 /404.html

# Compressão e cache (só aplica se o servidor tiver os módulos)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
Options -Indexes

# Domínio principal: agenciavisz.com
# Depois de ativar o SSL (HTTPS) no domínio, tire o "#" das linhas abaixo para
# mandar www.agenciavisz.com e o endereço sem HTTPS para https://agenciavisz.com
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://agenciavisz.com%{REQUEST_URI} [L,R=301]
